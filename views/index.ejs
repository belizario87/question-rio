<%- include('partials/header.ejs') %>
<body>
  <%- include('partials/navbar.ejs') %>
  <div class="container">
    <h1 class="mt-4 text-center">Perguntas</h1>
    <% if (questions && questions.length > 0) { %>
    <div class="list-group mt-4">
      <% questions.forEach(function(q) { %>
      <div class="list-group-item mb-3 shadow-sm">
        <div class="d-flex justify-content-between align-items-center">
          <div>
            <h5 class="mb-1"><%= q.titulo %></h5>
            <p class="mb-1"><%= q.descricao %></p>
          </div>
          <div class="d-flex gap-2">
            <button
              class="btn btn-outline-primary like-btn"
              data-question-id="<%= q.id %>"
              onclick="likeQuestion(this)"
            >
              <i class="bi bi-heart-fill"></i>
              <span class="likes-count"><%= q.likes || 0 %></span>
            </button>
            <button
              class="btn btn-outline-success answer-btn"
              onclick="toggleAnswerForm(this)"
              data-question-id="<%= q.id %>"
            >
              <i class="bi bi-chat-dots"></i>
              Responder
            </button>
          </div>
        </div>
        <!-- Lista de respostas -->
        <% if (q.respostas && q.respostas.length > 0) { %>
        <div class="mt-3">
          <h6 class="mb-2">Respostas:</h6>
          <% q.respostas.forEach(function(resposta) { %>
          <div class="card mb-2">
            <div class="card-body py-2"><%= resposta.resposta %></div>
          </div>
          <% }) %>
        </div>
        <% } %>
        <!-- Formulário de resposta (inicialmente oculto) -->
        <div class="answer-form mt-3" style="display: none">
          <form onsubmit="submitAnswer(event, <%= q.id %>)">
            <div class="form-group">
              <textarea
                class="form-control"
                rows="3"
                placeholder="Digite sua resposta..."
                required
              ></textarea>
            </div>
            <div class="mt-2">
              <button type="submit" class="btn btn-success btn-sm">
                Enviar Resposta
              </button>
              <button
                type="button"
                class="btn btn-secondary btn-sm"
                onclick="toggleAnswerForm(this)"
              >
                Cancelar
              </button>
            </div>
          </form>
        </div>
      </div>
      <% }) %>
    </div>
  </div>
  <% } else { %>
  <p class="mt-4">Nenhuma pergunta cadastrada.</p>
  <% } %>

  <!-- Modal de Sucesso -->
  <div class="modal fade" id="successModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title">Sucesso!</h5>
          <button
            type="button"
            class="btn-close"
            data-bs-dismiss="modal"
            aria-label="Close"
          ></button>
        </div>
        <div class="modal-body">
          <div class="alert alert-success" role="alert">
            Pergunta criada com sucesso!
          </div>
        </div>
      </div>
    </div>
  </div>
  <!-- Scripts -->
  <script>
    // Função para alternar visibilidade do formulário de resposta
    function toggleAnswerForm(button) {
      const questionDiv = button.closest(".list-group-item");
      const answerForm = questionDiv.querySelector(".answer-form");
      answerForm.style.display =
        answerForm.style.display === "none" ? "block" : "none";
    }

    // Função para enviar resposta
    async function submitAnswer(event, questionId) {
      event.preventDefault();
      const form = event.target;
      const textarea = form.querySelector("textarea");
      const resposta = textarea.value;

      try {
        const response = await fetch(`/pergunta/${questionId}/responder`, {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
          },
          body: JSON.stringify({ resposta }),
        });

        if (response.ok) {
          // Limpa o textarea e esconde o formulário
          textarea.value = "";
          form.closest(".answer-form").style.display = "none";
          // Recarrega a página para mostrar a nova resposta
          window.location.reload();
        } else {
          alert("Erro ao enviar resposta");
        }
      } catch (error) {
        console.error("Erro:", error);
        alert("Erro ao enviar resposta");
      }
    }
  </script>
  <script>
    async function likeQuestion(button) {
      const id = button.dataset.questionId;
      try {
        const response = await fetch(`/pergunta/${id}/like`, {
          method: "POST",
        });
        const data = await response.json();
        if (data.likes !== undefined) {
          button.querySelector(".likes-count").textContent = data.likes;
        }
      } catch (error) {
        console.error("Erro ao dar like:", error);
      }
    }

    // Mostrar modal se houver parâmetro success na URL
    if (new URLSearchParams(window.location.search).has("success")) {
      const modal = new bootstrap.Modal(
        document.getElementById("successModal")
      );
      modal.show();
      // Remove o parâmetro da URL sem recarregar a página
      window.history.replaceState({}, document.title, window.location.pathname);
    }
  </script>
  <%- include('partials/footer.ejs') %>
</body>
